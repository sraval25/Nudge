.theme-option{width:100%;display:flex;align-items:center;gap:12px;text-align:left;padding:13px 14px;border:1px solid var(--border,rgba(255,255,255,.28));border-radius:16px;background:rgba(255,255,255,.08);color:inherit;cursor:pointer;transition:.2s ease;position:relative}.theme-option:hover{transform:translateY(-1px)}.theme-option.selected{box-shadow:0 0 0 2px rgba(255,255,255,.45) inset;background:rgba(255,255,255,.16)}.theme-option .theme-icon{font-size:1.45rem;min-width:30px}.theme-option strong,.theme-option small{display:block}.theme-option small{opacity:.7;margin-top:2px;font-size:.76rem}.theme-option>b{margin-left:auto}.theme-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}.signout-btn{width:100%;margin-bottom:28px}.theme-pastel{--accent:#e99ab7;--bg:#fff1f7;--surface:rgba(255,255,255,.72);--text:#4d3340}.theme-ocean{--accent:#5bb6d9;--bg:#eaf8fc;--surface:rgba(255,255,255,.68);--text:#244553}.theme-sage{--accent:#7da98a;--bg:#eef7ef;--surface:rgba(255,255,255,.7);--text:#304638}.theme-strawberry{--accent:#ed789c;--bg:#fff0f4;--surface:rgba(255,255,255,.72);--text:#542d3a}.theme-midnight{--accent:#8ea7e8;--bg:#0c1326;--surface:rgba(30,42,73,.72);--text:#edf2ff}.theme-cafe{--accent:#b8895d;--bg:#f6eadc;--surface:rgba(255,250,242,.7);--text:#4b392a}.theme-pastel,.theme-ocean,.theme-sage,.theme-strawberry,.theme-midnight,.theme-cafe{background:var(--bg);color:var(--text)}.theme-pastel .card,.theme-ocean .card,.theme-sage .card,.theme-strawberry .card,.theme-midnight .card,.theme-cafe .card{background:var(--surface)}.theme-pastel .primary,.theme-ocean .primary,.theme-sage .primary,.theme-strawberry .primary,.theme-midnight .primary,.theme-cafe .primary{background:var(--accent)}
@media(max-width:600px){.theme-grid{grid-template-columns:1fr}.theme-option{padding:12px}.signout-btn{margin-bottom:18px}}

